# Copy to .env and adjust as needed. All values have sane defaults in src/rag/config.py.

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local Hugging Face model used for generation
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=5

# Storage
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=documents
DATA_DIR=./data
