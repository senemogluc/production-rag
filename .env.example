# Copy to .env and adjust as needed. All values have sane defaults in src/rag/config.py.

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local Hugging Face model used for generation
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=5
CANDIDATE_K=20
RETRIEVAL_MODE=dense
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage
# QDRANT_URL: if set, connects to a real Qdrant server (e.g. `docker compose up qdrant`).
# Leave blank to fall back to embedded/on-disk mode at QDRANT_PATH, no Docker needed.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=documents
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# App database. Defaults to the docker-compose "postgres" service. Use a sqlite:/// URL to run
# without Docker (e.g. sqlite:///./app.db).
DATABASE_URL=postgresql+psycopg://raguser:ragpass@localhost:5432/production_rag
APP_POSTGRES_USER=raguser
APP_POSTGRES_PASSWORD=ragpass # CHANGEME
APP_POSTGRES_DB=production_rag

# Evaluation harness (see evaluation/)
EVAL_NUM_QUESTIONS=30
EVAL_SEED=42
EVAL_DATASET_PATH=./evaluation/dataset.json
EVAL_RESULTS_PATH=./evaluation/results.csv

# Observability: Langfuse Cloud (free Hobby tier, https://cloud.langfuse.com). Sign up, create a
# project, and paste its API keys below. Leave both keys blank to disable tracing entirely, the
# app runs fine without it (wired up in V4 Part 2). Use https://us.cloud.langfuse.com for the US
# region instead if that's where your project was created.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
